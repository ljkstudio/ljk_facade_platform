<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net7.0-windows</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- 이유는 AdaptiveMold.Core.csproj 주석 참조 -->
    <NoWarn>NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <!-- Rhino.Testing 8.0.28-beta 가 NUnit 3.14.0 에 묶여 있다. 4.x 를 쓰면
         [RhinoTestFixture] 가 다른 NUnit 어셈블리의 속성이 되어 discovery 가
         **조용히** 건너뛴다 — 테스트가 사라지는데 러너는 통과라고 보고한다. -->
    <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
        <PackageReference Include="NUnitLite" Version="3.14.0" />
    <!-- 어댑터 계약 검사(자동검사 1·2)가 GH_Component 를 만든다.
         ExcludeAssets=runtime — Rhino 가 이미 로드해 둔 것을 쓴다.
         그래서 이 테스트들은 **GH 캔버스가 한 번 떠 있어야** 돈다. -->
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdaptiveMold.Core\AdaptiveMold.Core.csproj" />
    <ProjectReference Include="..\AdaptiveMold.GH\AdaptiveMold.GH.csproj" />
  </ItemGroup>

  <!-- 계약 테스트가 Core 의 '프로젝트 파일'을 읽어야 한다. 컴파일된 어셈블리로는
       검사할 수 없다 — 쓰지 않는 참조는 컴파일러가 매니페스트에서 지우므로
       규약 위반이 있어도 없어도 똑같이 보인다. -->
  <ItemGroup>
    <AssemblyMetadata Include="CoreCsprojPath" Value="$(MSBuildThisFileDirectory)..\AdaptiveMold.Core\AdaptiveMold.Core.csproj" />
    <AssemblyMetadata Include="GhCsprojPath" Value="$(MSBuildThisFileDirectory)..\AdaptiveMold.GH\AdaptiveMold.GH.csproj" />
    <AssemblyMetadata Include="ParamsJsonPath" Value="$(MSBuildThisFileDirectory)..\..\docs\params.ko.json" />
  </ItemGroup>

  <!-- 골든 픽스처를 출력 폴더로. 테스트가 TestContext.CurrentContext.TestDirectory
       기준으로 fixtures/ 를 찾는다. -->
  <ItemGroup>
    <None Include="..\fixtures\*.json" Link="fixtures\%(Filename)%(Extension)">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
