<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 단일 TFM. net8.0 은 구형 Rhino 8 에서 깨지고, net48 은 하위호환
         AppDomain 경로라 신규 개발이 갈 이유가 없다 (지시서 §3.1). -->
    <TargetFramework>net7.0-windows</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <TargetExt>.gha</TargetExt>
    <NoWarn>NU1701;NETSDK1086</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>AdaptiveMold.GH</RootNamespace>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <PropertyGroup>
    <!-- 어셈블리 버전이 패키지 버전의 정본이다. 매니페스트가 $version 으로
         이것을 따라간다 (설계 §6.4).
         주의: yak spec 은 패키지 '이름'을 여기가 아니라
         GH_AssemblyInfo.Name 에서 유도한다 (J-015 TRAP-01). -->
    <Version>0.1.0</Version>
    <Title>LJKS AdaptiveMold</Title>
    <Company>LJK STUDIO</Company>
    <Description>곡면 패널용 가변형 핀 몰드(다점프레스)의 액추에이터 높이 역산기.</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- 버전 고정 이유는 AdaptiveMold.Core.csproj 주석 참조. `8.*` 는 금물. -->
    <PackageReference Include="Grasshopper" Version="8.0.23304.9001" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AdaptiveMold.Core\AdaptiveMold.Core.csproj" />
  </ItemGroup>

  <!-- 툴팁 정본을 어셈블리에 굽는다. 파일로 두고 옆에서 읽으면 설치 폴더
       구조에 의존하게 되고, 사용자가 지우면 툴팁이 통째로 사라진다.
       LogicalName 을 고정하는 이유: 기본 이름은 폴더 구조에서 유도되므로
       파일을 옮기면 조용히 못 찾는다.

       WithCulture=false 가 없으면 안 된다. MSBuild 의 AssignCulture 가
       **파일명의 `.ko.` 를 한국어 컬처로 읽고** 이 리소스를 본체가 아니라
       `ko\AdaptiveMold.GH.resources.dll` 위성 어셈블리로 보낸다.
       빌드는 경고 0 오류 0 으로 성공하고, csc 명령줄에도 /resource: 가
       멀쩡히 보이며, 실패는 런타임에 GetManifestResourceStream 이 null 을
       주는 것으로만 드러난다. 실측: 본체 10,240 B / 위성 49,152 B. -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\docs\params.ko.json"
                      LogicalName="AdaptiveMold.GH.params.ko.json"
                      WithCulture="false" />
  </ItemGroup>

</Project>
